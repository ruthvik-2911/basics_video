# .env.example
# --- Azure AI Search ---
SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
SEARCH_ADMIN_KEY=your_search_admin_key

# --- Video Indexer (ARM account) ---
VI_SUBSCRIPTION_ID=your_subscription_id
VI_RESOURCE_GROUP=your_resource_group
VI_ACCOUNT_NAME=your_account_name
VI_ACCOUNT_ID=your_account_id
VI_LOCATION=eastus

# --- Azure Blob Storage ---
BLOB_CONNECTION_STRING=your_blob_connection_string
# BLOB_CONTAINER_RAW_VIDEOS=raw-videos
# BLOB_CONTAINER_KEYFRAMES=key-frames

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure Speech (Neural Voice) ---
AZURE_SPEECH_KEY=your_speech_key
AZURE_SPEECH_REGION=eastus

# --- Azure Document Intelligence ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_doc_intel_key
